/.idea/workspace.xml
/.idea/tasks.xml
/.idea/shelf/
/.idea/httpRequests/
/.idea/dataSources/
/.idea/dataSources.local.xml
/.idea/dictionaries/

# Personal simulation saves and exported runs
*.world
*.brain
/saves/
/checkpoints/
/exports/

# Local credentials, temporary files, and operating-system metadata
.env
.env.*
!.env.example
*.log
*.tmp
Thumbs.db
.DS_Store

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Java packages and archives
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*
